# =============================================================================
# ProducerHit — Google Cloud VPS + Supabase secrets
# =============================================================================
# Copie ce fichier en .env sur le VPS (Linux), remplis les valeurs,
# puis pousse les secrets "Supabase" via Dashboard ou :
#   npm run youtube:sync-secrets
#   supabase secrets set KEY=value ...
#
# Projet Supabase : pmfnzenqemnonpglmjqx (us-west-1)
# URL : https://pmfnzenqemnonpglmjqx.supabase.co
#
# Google Cloud Console (même compte que le VPS) :
#   1. APIs & Services → Enable "YouTube Data API v3"
#   2. OAuth consent screen → External → Production (refresh tokens longue durée)
#   3. Credentials → OAuth 2.0 :
#        - Web client → redirect https://www.producerhit.com/api/youtube-oauth-callback
#        - Desktop client → npm run youtube:oauth sur le VPS (refresh tokens)
#   4. Compute Engine → VM e2-small (2 vCPU, 2 GB) — us-central1 ou europe-west1
#   5. Firewall : SSH 22 uniquement (pas besoin d'exposer Hermes)
# =============================================================================

# ── A) SUPABASE — obligatoire (VPS agents + scripts + Edge Functions) ────────
# Où : VPS .env + Supabase secrets + GitHub secrets (workflows)

VITE_SUPABASE_URL=https://pmfnzenqemnonpglmjqx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...public
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...SECRET

# Secret partagé cron social / YouTube (génère une valeur aléatoire 32+ chars)
# Identique partout : Supabase Edge, GitHub, VPS si scripts publish locaux
SOCIAL_PUBLISH_CRON_SECRET=

# ── B) HERMES sur VPS — LLM cloud (recommandé, pas Ollama sur petit VM) ─────
# Où : UNIQUEMENT VPS — ~/.hermes/.env (PAS Supabase Edge)
# Crée une clé : https://console.groq.com/keys

GROQ_API_KEY=gsk_...
# Alternative :
# OPENROUTER_API_KEY=sk-or-...

# Hermes (Linux VPS)
HERMES_HOME=/home/TON_USER/.hermes
TZ=Europe/Paris

# Rapport Discord optionnel (VPS cron ou GitHub workflow automation-report)
AUTOMATION_REPORT_WEBHOOK=https://discord.com/api/webhooks/...

# ── C) YOUTUBE — OAuth depuis Google Cloud (même projet GCP) ────────────────
# Où : Supabase secrets (Edge social-publish-cron) + GitHub + VPS si besoin
# Obtenir refresh tokens : npm run youtube:oauth -- --account <id> (sur VPS ou PC)

YOUTUBE_ACCOUNTS=vibez,market,lowdey,producerhitai,beatmakerunion,remix1,remix2

# Compte principal (vibez / @ProducerVibez-d6y)
YOUTUBE_CLIENT_ID=....apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-...
YOUTUBE_REFRESH_TOKEN=1//...
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@ProducerVibez-d6y

# market
YOUTUBE_MARKET_CLIENT_ID=
YOUTUBE_MARKET_CLIENT_SECRET=
YOUTUBE_MARKET_REFRESH_TOKEN=
YOUTUBE_MARKET_CHANNEL_URL=https://www.youtube.com/@producermarket

# lowdey
YOUTUBE_LOWDEY_CLIENT_ID=
YOUTUBE_LOWDEY_CLIENT_SECRET=
YOUTUBE_LOWDEY_REFRESH_TOKEN=
YOUTUBE_LOWDEY_CHANNEL_URL=https://www.youtube.com/@Lowdey

# producerhitai
YOUTUBE_PRODUCERHITAI_CLIENT_ID=
YOUTUBE_PRODUCERHITAI_CLIENT_SECRET=
YOUTUBE_PRODUCERHITAI_REFRESH_TOKEN=
YOUTUBE_PRODUCERHITAI_CHANNEL_URL=https://www.youtube.com/@producerhitAI

# beatmakerunion
YOUTUBE_BEATMAKERUNION_CLIENT_ID=
YOUTUBE_BEATMAKERUNION_CLIENT_SECRET=
YOUTUBE_BEATMAKERUNION_REFRESH_TOKEN=
YOUTUBE_BEATMAKERUNION_CHANNEL_URL=https://www.youtube.com/@BeatmakerUnion

# Trend remix (landscape, pipeline npm run trend:run)
TREND_REMIX_YOUTUBE_ACCOUNTS=remix1,remix2
TREND_REMIX_AUTO_PUBLISH=1
TREND_REMIX_LANDSCAPE_THEME=cinematic-glow
TREND_REMIX_DURATION_SEC=90
TREND_REMIX_MAX_SEC=600

YOUTUBE_REMIX1_CLIENT_ID=
YOUTUBE_REMIX1_CLIENT_SECRET=
YOUTUBE_REMIX1_REFRESH_TOKEN=
YOUTUBE_REMIX1_CHANNEL_URL=

YOUTUBE_REMIX2_CLIENT_ID=
YOUTUBE_REMIX2_CLIENT_SECRET=
YOUTUBE_REMIX2_REFRESH_TOKEN=
YOUTUBE_REMIX2_CHANNEL_URL=

# Cadence publish (laisser ces valeurs sauf besoin spécifique)
YOUTUBE_PREVIEW_SEC=45
YOUTUBE_VIRAL_PREVIEW_SEC=18
YOUTUBE_MIN_INTERVAL_SEC=10800
YOUTUBE_GLOBAL_MIN_INTERVAL_SEC=3600
YOUTUBE_MAX_DAILY_PER_ACCOUNT=7
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_COMMUNITY_TEMPLATE=player
YOUTUBE_VIRAL_VISUAL=cover
YOUTUBE_RENDER_URL=https://www.producerhit.com/api/youtube-render
COMMUNITY_YOUTUBE_AUTO_PUBLISH=1
YOUTUBE_DAILY_AUTO_PUBLISH=1

# ── D) SOCIAL / VIRAL — Supabase + GitHub ───────────────────────────────────

SOCIAL_PUBLISH_PLATFORMS=webhook,twitter,indexnow,youtube
SOCIAL_PUBLISH_QUEUE_BATCH=1
PEXELS_API_KEY=

# TikTok (optionnel)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REFRESH_TOKEN=

# Twitter/X (optionnel)
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=

# IndexNow SEO
INDEXNOW_KEY=producerhit-indexnow-key

# ── E) VPS ONLY — pas dans Supabase ─────────────────────────────────────────

NODE_ENV=production
# Repo clone path on VPS
PRODUCERHIT_REPO=/home/TON_USER/producerhit

# Si tu installes Ollama sur VPS (non recommandé sur e2-small — préfère Groq)
# OLLAMA_HOST=127.0.0.1:11434
# OLLAMA_NUM_PARALLEL=1

# ── F) NE PAS mettre dans Supabase (frontend Vercel uniquement) ─────────────
# VITE_ACE_STEP_API_KEY=
# VITE_GA_MEASUREMENT_ID=
# STRIPE_* → déjà dans Supabase Edge pour stripe-webhook
