# npm run youtube:oauth:missing          # connecte tous les comptes sans refresh token
# npm run youtube:sync-secrets          # pousse .env → Supabase Edge
# YOUTUBE_VIRAL_PREVIEW_SEC=18           # Shorts viraux (12–30 s)
# YOUTUBE_LOCAL_REDIRECT_URI=http://localhost:8765
# YOUTUBE_REDIRECT_URI=https://www.producerhit.com/api/youtube-oauth-callback  # npm run youtube:oauth -- --web
# YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.force-ssl
# YOUTUBE_PRIVACY_STATUS=public
# YOUTUBE_PREVIEW_SEC=45               # Shorts preview (15–59 s)
# YOUTUBE_COMMUNITY_TEMPLATE=player     # player (blurred bg + music widget) | classic
# YOUTUBE_PLAYER_THEME=cinema          # cinema | prism | warm-glass (override auto-routing)
# YOUTUBE_VIRAL_VISUAL=cover            # cover (default) | stock (Pexels B-roll)
# YOUTUBE_FILM_DUST_OPACITY=0.42        # static film dust overlay strength (0.15–0.7)
# YOUTUBE_MIN_INTERVAL_SEC=10800       # 3 h min entre posts sur la même chaîne
# YOUTUBE_GLOBAL_MIN_INTERVAL_SEC=3600 # 1 h min entre deux posts (toutes chaînes)
# YOUTUBE_MAX_DAILY_PER_ACCOUNT=6      # plafond/jour/chaîne
# SOCIAL_PUBLISH_QUEUE_BATCH=1         # loops traitées par tick cron
# PEXELS_API_KEY=                      # B-roll viral Shorts — https://www.pexels.com/api/
# YOUTUBE_RENDER_URL=https://www.producerhit.com/api/youtube-render
# npm run youtube:render-preview -- <loopId>   # preview local template VHS art-school
# Google Cloud : YouTube Data API v3 + redirect localhost:8765 + consent Production (sinon refresh 7j)
# Vercel : YOUTUBE_* + SUPABASE_SERVICE_ROLE_KEY + SOCIAL_PUBLISH_CRON_SECRET (render + callback)
# supabase secrets set YOUTUBE_* SOCIAL_PUBLISH_CRON_SECRET=...
# supabase secrets set SOCIAL_PUBLISH_PLATFORMS=webhook,twitter,indexnow,youtube
# supabase functions deploy social-publish-cron --no-verify-jwt
# npm run social:publish  (test manuel queue)
# GitHub: workflow social-publish-cron.yml (backup */10 min) + secret SOCIAL_PUBLISH_CRON_SECRET

