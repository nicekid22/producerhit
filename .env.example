# --- TikTok Content Posting API (developers.tiktok.com) ---
# TIKTOK_CLIENT_KEY=          # client_key de l'app (pas TIKTOK_APP_ID)
# TIKTOK_CLIENT_SECRET=
# TIKTOK_APP_ID=              # optionnel (référence dashboard)
# TIKTOK_REFRESH_TOKEN=       # npm run tiktok:oauth (une fois) — voir scripts/tiktok-oauth.mjs
# TIKTOK_REDIRECT_URI=https://www.producerhit.com/api/tiktok-oauth-callback
#   ⚠ Login Kit : URI exacte (pas seulement https://www.producerhit.com/)
#   ⚠ Sandbox : target user = @producerhit.com (https://www.tiktok.com/@producerhit.com)
# TIKTOK_POST_MODE=MEDIA_UPLOAD   # inbox TikTok (recommandé app non auditée) | DIRECT_POST
# TIKTOK_SCOPES=video.upload,video.publish,user.info.basic
# Vérifier le domaine www.producerhit.com dans l'app TikTok (URL ownership) pour PULL_FROM_URL
# REDDIT — API restrictive depuis fin 2025 ; mode manuel recommandé
# REDDIT_CLIENT_ID=          # app « script » sur reddit.com/prefs/apps (si create app disponible)
# REDDIT_CLIENT_SECRET=
# REDDIT_REFRESH_TOKEN=      # npm run reddit:oauth -- --open
# REDDIT_LOCAL_REDIRECT_URI=http://localhost:8787
# REDDIT_POST_SUBREDDIT=SideProject   # ou: Songwriting | aiMusic | musicproduction | composer | WeAreTheMusicMakers
# REDDIT_MAX_COMMENTS_PER_DAY=3
# REDDIT_MAX_POSTS_PER_DAY=1
# REDDIT_MAX_POSTS_PER_WEEK=3
# REDDIT_MIN_MINUTES_BETWEEN_COMMENTS=120
# REDDIT_MIN_MINUTES_BETWEEN_POSTS=360
# REDDIT_CRON_INTERVAL_MINUTES=20
# REDDIT_MAX_COMMENTS_PER_RUN=1
# Agent assisté (navigateur connecté) : npm run reddit:agent -- --open
# Cron live (OAuth) : npm run reddit:cron -- --run --post
# Status quotas : npm run reddit:cron:status
# GitHub Actions : .github/workflows/reddit-cron.yml (*/20 * * * *, secrets REDDIT_*)
# Windows 20 min : .\scripts\register-reddit-cron-windows.ps1
# INDEXNOW_KEY=producerhit-indexnow-key
# TELEGRAM_BOT_TOKEN= TELEGRAM_CHANNEL_ID=  (optionnel)
