# ═══════════════════════════════════════════════════════════
# PRODUCERHIT — Variables d'environnement
# ═══════════════════════════════════════════════════════════
# Copie ce fichier en .env et remplis les valeurs

# ─── ACE API (Génération musicale) ───────────────────────
# https://ace.acusticaudio.com/
ACE_API_KEY=votre_cle_ace_api

# ─── TIKTOK API ──────────────────────────────────────────
# https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=votre_token_tiktok
TIKTOK_CLIENT_KEY=votre_client_key_tiktok
TIKTOK_CLIENT_SECRET=votre_client_secret_tiktok

# ─── YOUTUBE API ─────────────────────────────────────────
# https://console.cloud.google.com/
YOUTUBE_API_KEY=votre_cle_youtube
YOUTUBE_CHANNEL_IDS=UCxxxxxxx1,UCxxxxxxx2,UCxxxxxxx3,UCxxxxxxx4,UCxxxxxxx5

# ─── PEXELS API (Optionnel - vidéos gratuites) ───────────
# https://www.pexels.com/api/
PEXELS_API_KEY=votre_cle_pexels

# ─── CONFIGURATION ───────────────────────────────────────
# Langue par défaut: en ou fr
DEFAULT_LANG=en

# Nombre de vidéos par catégorie par jour
VIDEOS_PER_CATEGORY=2

# Délai entre les uploads (secondes)
UPLOAD_DELAY=10

# Mode debug: true ou false
DEBUG=false
