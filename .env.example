# Chaîne 1 — OAuth (prefixe REMIX1) :
# YOUTUBE_REMIX1_CLIENT_ID=
# YOUTUBE_REMIX1_CLIENT_SECRET=
# YOUTUBE_REMIX1_REFRESH_TOKEN=
# YOUTUBE_REMIX1_CHANNEL_URL=https://www.youtube.com/@YourRemixChannel1
#
# Chaîne 2 — OAuth (prefixe REMIX2) :
# YOUTUBE_REMIX2_CLIENT_ID=
# YOUTUBE_REMIX2_CLIENT_SECRET=
# YOUTUBE_REMIX2_REFRESH_TOKEN=
# YOUTUBE_REMIX2_CHANNEL_URL=https://www.youtube.com/@YourRemixChannel2
#
# Ajouter remix1,remix2 à YOUTUBE_ACCOUNTS ou laisser TREND_REMIX_YOUTUBE_ACCOUNTS les inclure auto.
