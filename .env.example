# --- Stripe (Edge Functions secrets — Supabase Dashboard → Project Settings → Edge Functions) ---
# STRIPE_SECRET_KEY=sk_live_... ou sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_... ou pk_test_...   # Embedded Checkout (front)
# STRIPE_PRICE_ID_PRO=price_1ThWOlJqW5V9MXwgrnXF3WVC
# STRIPE_PRICE_ID_STUDIO=price_1ThWPEJqW5V9MXwgKjYhuoE6
# STRIPE_PRICE_ID_PLUS=price_1ThWPgJqW5V9MXwgLpsf8HrT
# Annual plans (−20% vs monthly × 12) — recurring yearly in Stripe Dashboard
# STRIPE_PRICE_ID_PRO_ANNUAL=price_1Tk8SEJqW5V9MXwgt742n425      # $77/yr ($8/mo equiv.)
# STRIPE_PRICE_ID_STUDIO_ANNUAL=price_1Tk8SFJqW5V9MXwgHGrEC611   # $230/yr
# STRIPE_PRICE_ID_PLUS_ANNUAL=price_1Tk8SFJqW5V9MXwgYdqXoLL7     # $451/yr
# One-shot credit pack (+50 generations, $9) — create in Stripe Dashboard (mode: one-time payment)
# STRIPE_PRICE_ID_CREDIT_PACK_50=price_1Tk8SDJqW5V9MXwggKkClTAj

# Win-back checkout abandon (Edge nurture-abandoned-checkout + GitHub workflow)
# RESEND_API_KEY=re_xxx
# RESEND_FROM=ProducerHit <hello@producerhit.com>
# NURTURE_CRON_SECRET=...  # GitHub secret + supabase secrets (same as CRON_SECRET ok)
#
# Après création des prices Stripe (USD $8 / $24 / $47), insérer aussi en SQL :
# insert into public.billing_stripe_prices (plan, stripe_price_id) values
#   ('pro', 'price_1ThWOlJqW5V9MXwgrnXF3WVC'),
#   ('studio', 'price_1ThWPEJqW5V9MXwgKjYhuoE6'),
#   ('plus', 'price_1ThWPgJqW5V9MXwgLpsf8HrT')
# on conflict (plan) do update set stripe_price_id = excluded.stripe_price_id;
#
# Déploiement (JWT désactivé sur webhook — Stripe n'envoie pas de Bearer Supabase) :
# supabase db push
# supabase secrets set STRIPE_PRICE_ID_PRO=price_1ThWOlJqW5V9MXwgrnXF3WVC STRIPE_PRICE_ID_STUDIO=price_1ThWPEJqW5V9MXwgKjYhuoE6 STRIPE_PRICE_ID_PLUS=price_1ThWPgJqW5V9MXwgLpsf8HrT
# supabase functions deploy stripe-webhook --no-verify-jwt
# supabase functions deploy create-checkout create-portal generate-loop generate-loop-ace fetch-mood-image
#
# Share → Vidéo mood (photos Pexels, fallback Pollinations image) :
# PEXELS_API_KEY=...   # https://www.pexels.com/api/ — viral Shorts B-roll + fetch-mood-image (local .env + Supabase secret)
# supabase secrets set PEXELS_API_KEY=...
# supabase functions deploy fetch-mood-image

# --- LabelGrid music distribution (Edge Functions secrets — white-label DSP delivery) ---
# Sign up: https://labelgrid.com/features/white-label-and-api/
# Docs: https://api.labelgrid.com/docs/api
# LABELGRID_API_TOKEN=lg_...                    # production API bearer token
# LABELGRID_API_TOKEN_SANDBOX=lg_sandbox_...    # sandbox token (IP allowlist may be required)
# LABELGRID_API_BASE_URL=https://api.labelgrid.com/api/public
# LABELGRID_API_BASE_URL_SANDBOX=https://sandbox-api.labelgrid.com/api/public
# LABELGRID_WEBHOOK_SECRET=whsec_...            # webhook signature verification
# DISTRIBUTION_CRON_SECRET=...                  # cron sync fallback (can reuse CRON_SECRET)
# supabase secrets set LABELGRID_API_TOKEN=... LABELGRID_WEBHOOK_SECRET=... DISTRIBUTION_CRON_SECRET=...
# supabase functions deploy distribution-submit distribution-webhook distribution-sync-cron distribution-analytics
# distribution-webhook and distribution-sync-cron: --no-verify-jwt

# Mobile Dashboard v2 (onglets Créer/Résultats). Dev: activé par défaut. Prod: mettre 1 pour activer, 0 pour désactiver.
# VITE_MOBILE_DASHBOARD_V2=1

# Thème Cloud (3e skin + accents Air/Terre/Feu/Eau). Activé par défaut. Rollback : VITE_CLOUD_THEME=0
# VITE_CLOUD_THEME=0

# Lecture audio — conversion HTTP→blob avant play (évite silence Web Audio / CORS). Dev: activé par défaut.
# VITE_AUDIO_BLOB_PLAYBACK=0
# Secours sans visualizer (sortie directe <audio>) :
# VITE_AUDIO_SKIP_WEB_AUDIO=1
# Normalisation loudness à la lecture (gain Web Audio, sans modifier les fichiers). 0 = désactiver.
# VITE_PLAYBACK_LOUDNESS=0

# Audio hébergé Supabase Storage (loop-audio) — activé par défaut. 0 = inline Postgres (legacy).
# VITE_SUPABASE_LOOP_AUDIO_UPLOAD=0
# Rétention audio hébergé par plan (affichage UI) :
# VITE_LOOP_AUDIO_RETENTION_DAYS_FREE=1
# VITE_LOOP_AUDIO_RETENTION_DAYS_PRO=3
# VITE_LOOP_AUDIO_RETENTION_DAYS_STUDIO=7
# Legacy global (override tous plans) : VITE_LOOP_AUDIO_RETENTION_DAYS=7
# Purge cron Edge : CRON_SECRET + LOOP_AUDIO_RETENTION_DAYS (secrets Supabase, legacy)
# Scripts : npm run storage:migrate-inline | npm run storage:purge

# Génération ACE en prod (Vercel) :
# - Localhost : si VITE_ACE_STEP_API_KEY est dans .env → appel direct navigateur (chat/completions si release_task 404).
# - Prod sans cette clé : passe par Supabase Edge Function generate-loop-ace (secrets ACE_STEP_API_KEY requis).
# Option rapide (clé visible dans le bundle) : VITE_ACE_STEP_API_KEY + VITE_ACE_STEP_BASE_URL sur Vercel.
# 2 versions en local : même liste que ACE_STEP_API_KEYS (virgules) :
# VITE_ACE_STEP_API_KEY=first-key
# VITE_ACE_STEP_API_KEYS=key1,key2,key3
# VITE_ACE_STEP_BASE_URL=https://api.acemusic.ai
# Jobs async (poll 3s + Realtime) — évite le mur 150s visible quand release_task ACE répond.
# VITE_ACE_ASYNC_JOBS=1   # forcé ON ; sans clé VITE_ACE_* en prod = auto ON (GENERATION_ASYNC.md)
# VITE_ACE_ASYNC_JOBS=0   # rollback : repasse sur Edge sync (mur 150s)
# VITE_ACE_JOB_TIMEOUT_MS=0   # défaut : pas de plafond client (attendre fin ACE)
# VITE_ACE_POLL_TIMEOUT_MS=0  # idem poll navigateur local
# VITE_ACE_JOB_POLL_MS=3000
# Edge secrets : ACE_ASYNC_JOBS=1, ACE_ASYNC_TRY_RELEASE_TASK=1, ACE_INTERNAL_JOB_SECRET=<secret>
# Voir GENERATION_ASYNC.md

# Plan free : ×1 version par défaut (×2 si l'utilisateur choisit explicitement et localStorage producerhit_versions=2)

# Batch ×2 en prod (1 appel Edge) — activer après tests chansons longues :
# VITE_ACE_DUAL_BATCH_PROD=1

# Génération ×2 — défaut : parallel rapide + repli auto séquentiel si timeout/504 (adaptatif).
# Forcer un seul mode (désactive l'adaptatif) : VITE_ACE_DUAL_MODE=parallel|sequential|batch
# Chemin rapide si pas de VITE_ACE_DUAL_MODE : parallel (ou VITE_ACE_DUAL_FAST_PATH=batch)
# Rollback repli auto : VITE_ACE_DUAL_NO_FALLBACK=1  ou  VITE_ACE_DUAL_ADAPTIVE=0
# Mode stable uniquement : VITE_ACE_DUAL_MODE=sequential
# VITE_ACE_KEY_STRATEGY=auto|slot|rotate
# Pause séquentiel (fin v1 → début v2, ms) : VITE_ACE_V2_STAGGER_MS=2500
# Pause parallel (début v1 → début v2, ms) : VITE_ACE_V2_PARALLEL_STAGGER_MS=500
# Pas de timeout client Edge — la génération laisse ACE finir (messages réseau via UI).
# Legacy batch flag : VITE_ACE_DUAL_BATCH=1  (préférer VITE_ACE_DUAL_MODE=batch)
# Barre de % génération (estimation locale, pas ACE) : VITE_GEN_ESTIMATE_MS=95000
# Durée chanson « Auto » (laisser ACE décider) — rollback si besoin :
# VITE_ACE_SONG_AUTO_DURATION_SEC=90
# Supabase Edge generate-loop-ace (secret) : ACE_SONG_AUTO_DURATION_SEC=90

# Remix : par défaut recréation vibe Song/Beat (sans upload). Rollback upload ACE :
# VITE_REMIX_UPLOAD_ENABLED=1

# Covers cartes (workspace / bibliothèque) — Pollinations IA → Storage (seule source active).
# Backfill opt-in pour anciens morceaux sans cover : VITE_LOOP_COVER_BACKFILL=1
# supabase functions deploy persist-pollinations-cover

# Warm Glass — thème chaud opt-in (Dashboard / AppShell). Défaut au 1er visit si =1. Switch : sidebar ou Paramètres.
# VITE_WARM_GLASS_THEME=1

# Logo header : stack | beam | wordmark | cut | prism (défaut stack = deux lignes)
# Logo : wordmark lowercase dev-style (automatique par thème visuel)

