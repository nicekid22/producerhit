VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Stripe (Edge Functions secrets — Supabase Dashboard → Project Settings → Edge Functions) ---
# STRIPE_SECRET_KEY=sk_live_... ou sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_STUDIO=price_...
# STRIPE_PRICE_ID_PLUS=price_1Tc9IsJqW5V9MXwgBB0dlFcp
#
# Après création des prices Stripe, insérer aussi en SQL (voir supabase/scripts/deploy_plus_plan.sql) :
# insert into public.billing_stripe_prices (plan, stripe_price_id) values
#   ('pro', 'price_...'),
#   ('studio', 'price_...'),
#   ('plus', 'price_1Tc9IsJqW5V9MXwgBB0dlFcp')
# on conflict (plan) do update set stripe_price_id = excluded.stripe_price_id;
#
# Déploiement (JWT désactivé sur webhook — Stripe n'envoie pas de Bearer Supabase) :
# supabase db push
# supabase secrets set STRIPE_PRICE_ID_PLUS=price_1Tc9IsJqW5V9MXwgBB0dlFcp
# supabase functions deploy stripe-webhook --no-verify-jwt
# supabase functions deploy create-checkout create-portal generate-loop generate-loop-ace

# Mobile Dashboard v2 (onglets Créer/Résultats). Dev: activé par défaut. Prod: mettre 1 pour activer, 0 pour désactiver.
# VITE_MOBILE_DASHBOARD_V2=1

# Lecture audio — conversion HTTP→blob avant play (évite silence Web Audio / CORS). Dev: activé par défaut.
# VITE_AUDIO_BLOB_PLAYBACK=0
# Secours sans visualizer (sortie directe <audio>) :
# VITE_AUDIO_SKIP_WEB_AUDIO=1

