rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Loop audio: authenticated users can upload their own loops ──
    match /loop-audio/{userId}/{fileName} {
      // Read: anyone (public playback)
      allow read: if true;
      // Write: only authenticated users writing to their own folder
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 20 * 1024 * 1024  // max 20 MB
                            && request.resource.contentType.matches('audio/.*');
      // Delete: only owner
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── User avatars ──
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024;  // max 5 MB
    }

    // ── Cover art for loops ──
    match /cover-art/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // ── Loop covers (Pollinations-generated covers persisted to Storage) ──
    // Path: loop-covers/{userId}/covers/{loopId}.ext — use {allPaths=**} to match nested paths
    match /loop-covers/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
                           && request.auth.uid == userId
                           && request.resource.size < 5 * 1024 * 1024
                           && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Producer tags (user-uploaded jingles 3–8 s, applied to loops) ──
    // Path: producer-tags/{userId}/tags/{file}.{wav,mp3} — written by client upload.
    match /producer-tags/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
                           && request.auth.uid == userId
                           && request.resource.size < 10 * 1024 * 1024
                           && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Stems zip ──
    match /stems/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024;  // max 50 MB
    }
  }
}
