# =============================================================================
# Odysseus sur Google Cloud VPS — .env (dans le dossier odysseus/, PAS Supabase)
# =============================================================================
# Odysseus = serveur agents TITAN / INFLU / VIRAL (Team 4)
# Ce fichier va sur le VPS : /home/USER/odysseus/.env
#
# ⚠ Ce n'est PAS le même .env que ProducerHit ni les secrets Supabase Edge.
# Supabase = publish YouTube, loops, social (Edge Functions)
# Odysseus  = agents autonomes, recherche web, email, rapports Documents/
# =============================================================================

# ── Serveur Odysseus (VPS) ───────────────────────────────────────────────────
APP_BIND=127.0.0.1
APP_PORT=7000
TZ=Europe/Paris

# Premier admin (setup.py) — change après install
ODYSSEUS_ADMIN_USER=admin
ODYSSEUS_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# HTTPS derrière nginx/Caddy sur le VPS
# SECURE_COOKIES=true
# ALLOWED_ORIGINS=https://odysseus.tondomaine.com

# ── LLM — choisir UNE option ─────────────────────────────────────────────────

# Option A (recommandée VPS e2-small) : API cloud, pas Ollama local
OPENAI_API_KEY=
# Odysseus Settings UI → add endpoint OpenAI-compatible :
#   Groq  : https://api.groq.com/openai/v1  + model llama-3.1-8b-instant
#   OpenRouter : https://openrouter.ai/api/v1

# Option B : Ollama sur le MÊME VPS (e2-medium minimum, 4 GB RAM)
LLM_HOST=localhost
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Sur VPS Linux :
#   curl -fsSL https://ollama.com/install.sh | sh
#   OLLAMA_HOST=0.0.0.0:11434 ollama serve
#   ollama pull qwen2.5:7b   # plus léger que 64k

# Option C : Ollama sur un 2e petit service (séparer charge)
# LLM_HOST=10.x.x.x
# OLLAMA_BASE_URL=http://10.x.x.x:11434/v1

# ── Recherche web (Radar TITAN, INFLU Scout…) ───────────────────────────────
# SearXNG sur le VPS (docker) :
SEARXNG_INSTANCE=http://127.0.0.1:8080
# SEARXNG_SECRET=random_secret_32_chars

# ── Mémoire vectorielle (optionnel au début) ────────────────────────────────
CHROMADB_HOST=127.0.0.1
CHROMADB_PORT=8100

# Embeddings (si pas Chroma local, Ollama suffit)
# EMBEDDING_URL=http://127.0.0.1:11434/v1/embeddings
# EMBEDDING_MODEL=nomic-embed-text

# ── Email autonome INFLU (optionnel) ─────────────────────────────────────────
# Configurer dans l'UI Odysseus → Email → Add account
# Pas de secret ici sauf si SMTP custom

# ── Cadence agents (après agents:light sur VPS) ────────────────────────────
# Sur le VPS, ne PAS relancer tous les crons TITAN toutes les 15 min.
# Garder la grille légère (1 job/heure) ou Odysseus restera saturé.
# ODYSSEUS_INPROCESS_TASKS=1

# ── NE PAS mettre ici (reste sur Supabase / ProducerHit) ───────────────────
# YOUTUBE_* , SOCIAL_PUBLISH_CRON_SECRET , SUPABASE_SERVICE_ROLE_KEY
# → Supabase Edge + GitHub Actions pour publish YouTube/Viral
#
# ProducerHit repo .env = uniquement si tu lances des scripts npm sur le VPS
# (youtube-daily, viral) — séparé d'Odysseus.
