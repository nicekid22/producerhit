{
  "name": "trae-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "vite --force",
    "build": "npm run generate:seo && tsc -b && vite build",
    "generate:seo": "node scripts/generate-seo-prerender.mjs && node scripts/sync-seo-sitemap.mjs && node scripts/sync-community-sitemap.mjs && node scripts/sync-rss.mjs && node scripts/sync-vercel-seo-prerender.mjs && node scripts/growth-sync.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "test": "vitest --run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test e2e/public-audit.spec.ts",
    "test:e2e:auth": "playwright test e2e/authenticated.spec.ts",
    "blog:auto": "node scripts/auto-blog.mjs",
    "growth:sync": "node scripts/growth-sync.mjs",
    "growth:social": "node scripts/auto-social.mjs",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "db:migrate:039": "node scripts/apply-migration-039.mjs",
    "storage:purge": "node scripts/purge-expired-loop-audio.mjs",
    "storage:migrate-inline": "node scripts/migrate-inline-to-storage.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.2",
    "replicate": "^1.4.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.3.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
