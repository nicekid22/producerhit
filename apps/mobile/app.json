{
  "expo": {
    "name": "ProducerHit",
    "slug": "producerhit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "producerhit",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1220"
    },
    "locales": {
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "pt": "./locales/pt.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json",
      "nl": "./locales/nl.json",
      "ar": "./locales/ar.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "tr": "./locales/tr.json",
      "hi": "./locales/hi.json",
      "zh": "./locales/zh.json",
      "th": "./locales/th.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.producerhit.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "fr",
          "es",
          "pt",
          "de",
          "it",
          "nl",
          "ar",
          "ja",
          "ko",
          "tr",
          "hi",
          "zh",
          "th"
        ]
      },
      "associatedDomains": [
        "applinks:www.producerhit.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1220"
      },
      "package": "com.producerhit.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "react-native-iap",
      "expo-apple-authentication",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "fr",
              "es",
              "pt",
              "de",
              "it",
              "nl",
              "ar",
              "ja",
              "ko",
              "tr",
              "hi",
              "zh",
              "th"
            ],
            "android": [
              "en",
              "fr",
              "es",
              "pt",
              "de",
              "it",
              "nl",
              "ar",
              "ja",
              "ko",
              "tr",
              "hi",
              "zh",
              "th"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b9b8bfc-2b0e-44b3-a165-d54168a0dbab"
      }
    },
    "owner": "hype22"
  }
}
