# Copy from repo root .env (VITE_SUPABASE_* → EXPO_PUBLIC_*)
# Covers cartes : Pollinations → Storage (seule source)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# App Store Connect subscription products (create before IAP testing)
EXPO_PUBLIC_IAP_PRO_MONTHLY=com.producerhit.app.pro.monthly
EXPO_PUBLIC_IAP_STUDIO_MONTHLY=com.producerhit.app.studio.monthly
EXPO_PUBLIC_IAP_PLUS_MONTHLY=com.producerhit.app.plus.monthly

# Apple Developer Team ID — used by scripts/generate-aasa.mjs for Universal Links
# APPLE_TEAM_ID=
